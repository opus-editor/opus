{
  "name": "css",
  "title": "CSS",
  "file-types": [
    "css"
  ],
  "injection-regex": "css",
  "pairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "not-in": ["string"] },
    { "open": "'", "close": "'", "not-in": ["string", "comment"] },
    { "open": "/*", "close": " */", "not-in": ["string", "comment"] }
  ],
  "grammar": {
    "repository": "https://github.com/tree-sitter/tree-sitter-css",
    "rev": "dda5cfc5722c429eaba1c910ca32c2c0c5bb1a3f"
  }
}
