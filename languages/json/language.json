{
  "name": "json",
  "title": "JSON",
  "file-types": [
    "json",
    "arb",
    "ipynb",
    "geojson",
    "gltf",
    "webmanifest",
    { "glob": "flake.lock" },
    { "glob": ".babelrc" },
    { "glob": ".bowerrc" },
    { "glob": ".jscrc" },
    "js.map",
    "ts.map",
    "css.map",
    { "glob": ".jslintrc" },
    "jsonl",
    { "glob": ".vuerc" },
    { "glob": "composer.lock" },
    { "glob": ".watchmanconfig" },
    "avsc",
    "ldtk",
    "ldtkl",
    { "glob": ".swift-format" },
    "sublime-build",
    "sublime-color-scheme",
    "sublime-commands",
    "sublime-completions",
    "sublime-keymap",
    "sublime-macro",
    "sublime-menu",
    "sublime-mousemap",
    "sublime-project",
    "sublime-settings",
    "sublime-theme",
    "sublime-workspace",
    "code-workspace",
    { "glob": ".pytest_cache/v/cache/*" },
    { "glob": "devenv.lock" },
    { "glob": "devbox.lock" },
    { "glob": "manifest.lock" },
    { "glob": "deno.lock" },
    "tfstate",
    { "glob": "*.tfstate.backup" }
  ],
  "injection-regex": "json",
  "grammar": {
    "repository": "https://github.com/tree-sitter/tree-sitter-json",
    "rev": "001c28d7a29832b06b0e831ec77845553c89b56d"
  }
}
