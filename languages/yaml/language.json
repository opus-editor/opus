{
  "name": "yaml",
  "file-types": [
    "yml",
    "yaml",
    { "glob": ".prettierrc" },
    { "glob": ".clangd" },
    { "glob": ".clang-format" },
    { "glob": ".clang-tidy" },
    { "glob": ".gem/credentials" },
    { "glob": ".kube/config" },
    { "glob": ".kube/kuberc" },
    { "glob": "yarn.lock" },
    "sublime-syntax",
    "bu",
    { "glob": ".stylelintrc" },
    { "glob": ".puppeteerrc" },
    { "glob": ".bundle/config" }
  ],
  "injection-regex": "yml|yaml",
  "grammar": {
    "repository": "https://github.com/ikatyang/tree-sitter-yaml",
    "rev": "0e36bed171768908f331ff7dff9d956bae016efb"
  }
}
