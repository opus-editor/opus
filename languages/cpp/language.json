{
  "name": "cpp",
  "title": "C++",
  "file-types": [
    "cc",
    "hh",
    "c++",
    "cpp",
    "hpp",
    "h",
    "ipp",
    "tpp",
    "cxx",
    "hxx",
    "ixx",
    "txx",
    "ino",
    "C",
    "H",
    "cu",
    "cuh",
    "cppm",
    "h++",
    "ii",
    "inl",
    { "glob": ".hpp.in" },
    { "glob": ".h.in" }
  ],
  "injection-regex": "cpp",
  "pairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "not-in": ["string"] },
    { "open": "'", "close": "'", "not-in": ["string", "comment"] },
    { "open": "/*", "close": " */", "not-in": ["string", "comment"], "newline": false }
  ],
  "grammar": {
    "repository": "https://github.com/tree-sitter/tree-sitter-cpp",
    "rev": "8b5b49eb196bec7040441bee33b2c9a4838d6967"
  }
}
