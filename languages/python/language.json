{
  "name": "python",
  "file-types": [
    "py",
    "pyi",
    "py3",
    "pyw",
    "ptl",
    "rpy",
    "cpy",
    "ipy",
    "pyt",
    { "glob": ".python_history" },
    { "glob": ".pythonstartup" },
    { "glob": ".pythonrc" },
    { "glob": "*SConstruct" },
    { "glob": "*SConscript" },
    { "glob": "*sconstruct" }
  ],
  "shebangs": [
    "python",
    "uv"
  ],
  "injection-regex": "py(thon)?",
  "grammar": {
    "repository": "https://github.com/tree-sitter/tree-sitter-python",
    "rev": "293fdc02038ee2bf0e2e206711b69c90ac0d413f"
  }
}
