{
  "name": "rust",
  "title": "Rust",
  "file-types": [
    "rs"
  ],
  "shebangs": [
    "rust-script",
    "cargo"
  ],
  "injection-regex": "rs|rust",
  "pairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "<", "close": ">", "not-in": ["string", "comment"], "auto-close": false },
    { "open": "\"", "close": "\"", "not-in": ["string"] },
    { "open": "/*", "close": " */", "not-in": ["string", "comment"] }
  ],
  "grammar": {
    "repository": "https://github.com/tree-sitter/tree-sitter-rust",
    "rev": "77a3747266f4d621d0757825e6b11edcbf991ca5"
  }
}
