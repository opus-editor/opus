using Gtk 4.0;

Gtk.Box row {
  orientation: horizontal;
  spacing: 6;

  Gtk.TreeExpander expander {
    hexpand: true;

    child: Gtk.Box {
      orientation: horizontal;
      spacing: 6;

      Gtk.Image icon {
        pixel-size: 16;
      }

      Gtk.Label label {
        xalign: 0;
        ellipsize: end;
        hexpand: true;
        opacity: 0.75;
      }

      // Shown instead of `label`, only while this row is a New
      // File/Folder placeholder still being named — see EditorView.ExplorerPaneTreeRow.bind().
      Gtk.Text edit_entry {
        hexpand: true;
        visible: false;
        opacity: 0.75;
      }

      // A plugin's own decoration (git status, a future linter badge, …)
      // — see ExplorerPaneTreeRow.update_decoration(). label's own
      // hexpand: true already consumes the row's remaining width up to
      // here, so this small fixed-size sibling lands pinned to the
      // row's true right edge with no further layout needed.
      Gtk.Box decoration_dot {
        valign: center;
        visible: false;

        styles ["decoration-dot"]
      }
    };
  }
}
