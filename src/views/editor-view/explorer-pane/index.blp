using Gtk 4.0;

Gtk.Box root_box {
  orientation: vertical;

  Gtk.Box root_header_box {
    Gtk.Box {
      styles ["mt-200", "me-150", "ms-300", "mb-200"]
      orientation: vertical;
      hexpand: true;

      Gtk.Label root_label {
        styles ["file-tree-root-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }

      Gtk.Label branch_label {
        styles ["file-tree-branch-label", "dim-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }
    }

    Gtk.Box {
      styles ["mt-200", "me-150", "mb-200"]
      orientation: vertical;
      margin-start: 0;

      Gtk.Button more_button {
        styles ["btn-sm", "btn-icon", "flat"]
        icon-name: "opus-more-symbolic";
      }
    }

  }

  Gtk.ScrolledWindow scrolled_window {
    vexpand: true;
  }
}
