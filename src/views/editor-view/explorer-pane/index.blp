using Gtk 4.0;

Gtk.Box root_box {
  orientation: vertical;

  Gtk.Box root_header_box {
    Gtk.Box {
      orientation: vertical;
      hexpand: true;
      margin-top: 8;
      margin-end: 6;
      margin-start: 12;
      margin-bottom: 8;

      Gtk.Label root_label {
        styles ["file-tree-root-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }

      Gtk.Label branch_label {
        styles ["file-tree-branch-label", "dim-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }
    }

    Gtk.Box {
      orientation: vertical;
      margin-top: 8;
      margin-end: 6;
      margin-start: 0;
      margin-bottom: 8;

      Gtk.Button more_button {
        styles ["root-header-more-button", "flat"]
        icon-name: "open-menu-symbolic";
      }
    }

  }

  Gtk.ScrolledWindow scrolled_window {
    vexpand: true;
  }
}
