using Gtk 4.0;

Gtk.Box root_box {
  orientation: vertical;

  Gtk.Box root_header_box {
    styles ["sidebar-pane-header"]

    Gtk.Box {
      styles ["me-150", "ms-300"]
      orientation: vertical;
      // A hair between the two lines, and the 30px that lands the pair
      // dead center in the header's own 30 — see .sidebar-pane-header.
      spacing: 1;
      valign: center;
      hexpand: true;

      Gtk.Label root_label {
        styles ["file-tree-root-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }

      Gtk.Label branch_label {
        styles ["file-tree-branch-label", "dim-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }
    }

    Gtk.Box {
      styles ["me-150"]
      orientation: vertical;
      valign: center;
      margin-start: 0;

      Gtk.Button more_button {
        styles ["btn-sm", "btn-icon", "flat"]
        icon-name: "opus-more-symbolic";
      }
    }

  }

  Gtk.ScrolledWindow scrolled_window {
    vexpand: true;
  }
}
