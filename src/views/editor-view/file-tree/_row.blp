using Gtk 4.0;

Gtk.Box row {
  orientation: horizontal;
  spacing: 6;

  Gtk.TreeExpander expander {
    hexpand: true;

    child: Gtk.Box {
      orientation: horizontal;
      spacing: 6;

      Gtk.Image icon {
        pixel-size: 16;
      }

      Gtk.Label label {
        xalign: 0;
        ellipsize: end;
        hexpand: true;
      }

      // Shown instead of `label`, only while this row is a New
      // File/Folder placeholder still being named — see EditorView.FileTreeRow.bind().
      Gtk.Text edit_entry {
        hexpand: true;
        visible: false;
      }
    };
  }
}
