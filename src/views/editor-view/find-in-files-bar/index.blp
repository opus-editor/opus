using Gtk 4.0;
using Adw 1;

// Gtk.SearchBar is a real GTK widget purpose-built for exactly this: its
// own CSS node is genuinely named "searchbar", so libadwaita's real
// searchbar stylesheet (background, inset shadow line, padding, and —
// via show-close-button below — the small circular .close button) applies
// with zero CSS of our own, the same look GNOME Text Editor's own custom
// EditorSearchBar widget borrows by hand (checked its source,
// editor-search-bar.c: gtk_widget_class_set_css_name (widget_class,
// "searchbar")). connect_entry() in the .vala file wires the rest of the
// native behavior (Escape-to-close, auto-focus-on-open, auto-clear-on-
// close) — checked gtksearchbar.c, no code of our own needed for any of
// it. Only its own internal reveal transition isn't ours to pick (it's
// private to GtkSearchBar, always a crossfade) — Text Editor's own real
// bar uses a hand-built revealer specifically to get a slide-up instead;
// good enough for a first, purely visual pass.
Gtk.SearchBar search_bar {
  show-close-button: true;

  // other_buttons + the entry/Previous/Next group are one combined,
  // width-capped unit here — both centered together, not other_buttons
  // floating independently over a still-perfectly-centered clamp: a
  // real tradeoff, but more visual machinery than it's worth here.
  // Checked GtkSearchBar's own real source (gtksearchbar.c):
  // whatever `child` we give it lands as the *center* widget of a real
  // Gtk.CenterBox it already builds internally (hexpand: true), with its
  // own close button as that CenterBox's *end* widget — so the close
  // button still sits pinned at the true far edge regardless, only what
  // "the center" means changed.
  child: Adw.Clamp {
    maximum-size: 640;

    // A Gtk.Grid, not two independent rows of boxes — the Where row's
    // own entry needs to line up under the Find row's search entry, the
    // same reason GNOME Text Editor's own real search bar uses GtkGrid
    // for this (editor-search-bar.ui). other_buttons + the divider only
    // exist on row 0 (column 0/1) and are simply absent from row 1 —
    // Grid still reserves their column widths, which is what keeps
    // column 2 (the entries) aligned between both rows without needing
    // an invisible placeholder in row 1.
    child: Gtk.Grid search_grid {
      row-spacing: 6;
      column-spacing: 6;

      Gtk.Box other_buttons {
        spacing: 3;

        layout {
          column: 0;
          row: 0;
        }

        Gtk.ToggleButton regex_button {
          styles ["flat"]
          icon-name: "regex-symbolic";
          tooltip-text: _("Regular Expressions");
          focus-on-click: false;
        }

        Gtk.ToggleButton case_sensitive_button {
          styles ["flat"]
          icon-name: "case-sensitive-symbolic";
          tooltip-text: _("Case Sensitive");
          focus-on-click: false;
        }

        Gtk.ToggleButton whole_word_button {
          styles ["flat"]
          icon-name: "whole-word-symbolic";
          tooltip-text: _("Match Whole Word Only");
          focus-on-click: false;
        }
      }

      // Same class MainWindow's own install_css() already styles
      // (a subtler mix of --border-color, not the default separator's
      // full-strength one — see its own comment) — reused as-is here,
      // no new CSS needed. valign: center (not the default fill) plus
      // an explicit height keeps it a short, centered divider instead
      // of stretching to the row's own full height — GTK has no
      // percentage sizing, so this is a fixed guess at roughly half a
      // button's own height, not a computed 50%; adjust if it looks off
      // once actually on screen.
      Gtk.Separator {
        orientation: vertical;
        styles ["content-divider"]
        valign: center;
        height-request: 18;

        layout {
          column: 1;
          row: 0;
        }
      }

      // search_grid's (2, 0) cell is deliberately left empty here — no
      // way for Blueprint to place a SearchInput (a same-project
      // custom Gtk.Widget, not something blueprint-compiler has
      // introspection data for). EditorView.FindBar's own constructor builds one
      // and grid.attach()es it into that exact cell instead — same
      // "custom widget built in code, blueprint just reserves where it
      // goes" split CodeEditor already uses for its own CodeEditorSourceView
      // (built in code, dropped into scrolled_window via set_child()).

      // A single Search action, not FindBar's own Previous/Next pair —
      // Find in Files has no single live match to step through, it (re)runs
      // the whole cross-file search. Lone widget in the cell, same
      // halign: start reasoning as more_button below, hugging
      // search_input's own right edge instead of stretching or drifting
      // to the far right.
      Gtk.Button search_button {
        styles ["flat"]
        icon-name: "search-symbolic";
        tooltip-text: _("Search");
        focus-on-click: false;
        halign: start;

        layout {
          column: 3;
          row: 0;
        }
      }

      // Row 1 — the search scope (which folder/glob to search within),
      // always visible. gitignore_button/where_divider/where_entry/
      // more_button sit in columns 0/1/2/3, same as other_buttons/the
      // row 0 divider/search_input/search_button above them, so this
      // row's own entry lines up under the Find row's search entry —
      // see the Grid's own doc comment above for why that needs a Grid
      // at all.
      Gtk.ToggleButton gitignore_button {
        styles ["flat"]
        icon-name: "gitignore-symbolic";
        tooltip-text: _("Use gitignore");
        focus-on-click: false;
        active: true;
        // A lone widget in its own Grid cell defaults to halign: fill —
        // other_buttons above doesn't need this itself since a Gtk.Box
        // only ever paints its own children at their natural size
        // regardless of how much cell width it's allocated, but a
        // single button here has nothing else to hide that stretch.
        // end, not start: column 0 is only ever this wide because of
        // other_buttons' own 3 buttons in row 0, so hugging the start
        // edge would leave a gap before where_divider instead of
        // sitting flush against it.
        halign: end;

        layout {
          column: 0;
          row: 1;
        }
      }

      // Same class/sizing as row 0's own divider above.
      Gtk.Separator where_divider {
        orientation: vertical;
        styles ["content-divider"]
        valign: center;
        height-request: 18;

        layout {
          column: 1;
          row: 1;
        }
      }

      // hexpand here (not on gitignore_button/where_divider) is what
      // actually reaches the clamp's maximum-size (same reasoning as
      // search_input's own hexpand, see FindBar's own doc comment on
      // that), but only within column 2's own share of the grid, so it
      // lines up flush with the Find row's own entry above it instead of
      // also running under its own toggle-button column.
      // Same idiom as .gitignore itself (checked git-scm.com/docs/
      // gitignore) rather than a syntax of our own: leading "/" anchors
      // to the search root, "!" negates, "**" for any depth — a
      // developer already knows this from every .gitignore they've
      // ever written, and it's the same mental model "Use gitignore"
      // (gitignore_button) already applies for real via git itself.
      Gtk.Entry where_entry {
        hexpand: true;
        placeholder-text: _("Where - /src, !/build, *.js...");
        tooltip-text: _("Comma-separated patterns, same syntax as .gitignore.");

        layout {
          column: 2;
          row: 1;
        }
      }

      // Lone widget in column 3, same story as gitignore_button in
      // column 0 above but mirrored: halign: start (not the fill
      // default) hugs where_entry's own right edge instead of stretching
      // across all of column 3's width (as wide as search_button's own
      // column above it) or drifting to its far right edge. Same icon
      // as always (more-symbolic) — only its own meaning/tooltip changed,
      // see MainWindow's own on_add_folder_requested() for what it does.
      Gtk.Button add_folder_button {
        styles ["flat"]
        icon-name: "more-symbolic";
        tooltip-text: _("Add Folder…");
        focus-on-click: false;
        halign: start;

        layout {
          column: 3;
          row: 1;
        }
      }
    };
  };
}
