using Gtk 4.0;

// The "File Has Changed on Disk" banner EditorPane slides in above the
// editor — a file concern, so it lives here with the tab/file
// bookkeeping rather than inside the CodeEditor component, which has no
// notion of a file on disk at all.
Gtk.Revealer revealer {
  transition-type: slide_down;

  Gtk.Box {
    styles ["change-banner"]
    orientation: horizontal;
    spacing: 6;

    Gtk.Box {
      orientation: vertical;
      spacing: 6;
      hexpand: true;
      valign: center;

      Gtk.Label {
        styles ["change-banner-title"]
        halign: start;
        wrap: true;
        label: _("File Has Changed on Disk");
      }

      Gtk.Label {
        halign: start;
        wrap: true;
        label: _("The file has been changed by another program.");
      }
    }

    Gtk.Button discard_button {
      valign: center;
      label: _("_Discard Changes and Reload");
      use-underline: true;
    }
  }
}
