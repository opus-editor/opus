using Gtk 4.0;

// The header and the Find/Replace row only — the results body is a
// read-only CodeEditor (views/components/code-editor), built in code and
// appended to root last.
Gtk.Box root {
  orientation: vertical;

  Gtk.Box header {
    styles ["find-results-header"]
    orientation: horizontal;
    spacing: 6;

    Gtk.Label header_label {
      halign: start;
      wrap: true;
      hexpand: true;
    }

    // The context-lines control — a single Gtk.Entry (not a
    // Gtk.SpinButton: no up/down steppers in the requested layout) plus
    // a toggle that shows/hides context without losing the typed
    // number, same split VS Code's own Search Editor uses
    // (contextLinesInput + showContextToggle, checked in
    // searchWidget.ts) — unchecking doesn't clear the entry, it just
    // searches with 0 context until re-checked.
    Gtk.Box context_lines_group {
      styles ["linked"]

      Gtk.Entry context_lines_entry {
        styles ["compact-control"]
        input-purpose: number;
        width-chars: 2;
        max-width-chars: 3;
        text: "1";
        tooltip-text: _("Context Lines");
      }

      // Not "flat" either — paired with context_lines_entry's own
      // normal (non-flat) background in the same linked group, a flat
      // toggle here would look visually detached from it rather than
      // reading as one joined pill.
      Gtk.ToggleButton context_lines_toggle {
        styles ["compact-control"]
        icon-name: "content-lines-symbolic";
        tooltip-text: _("Show Context Lines");
        active: true;
        focus-on-click: false;
      }
    }

    // Toggles replace_revealer below — see on_replace_button_toggled().
    // A ToggleButton, not a plain Button: its own :checked state (kept
    // in sync with replace_revealer.reveal-child there) is what makes it
    // read as pressed/active while the row is open, same as
    // context_lines_toggle above already does for its own row.
    // compact-control (styles/common.css) is a shared, app-wide utility
    // class, not specific to this view — see its own doc comment. Not
    // "flat" — that class is what removes a button's own background
    // until hover (checked libadwaita's own _buttons.scss), fine for the
    // icon-only toolbar buttons elsewhere in this app but not for a
    // labeled action button meant to read as clickable at rest.
    Gtk.ToggleButton replace_button {
      styles ["compact-control"]
      focus-on-click: false;

      // label + a chevron together — Gtk.Button's own icon-name is
      // icon-only (fine for context_lines_toggle above), so this needs
      // its own child instead.
      Gtk.Box {
        spacing: 4;

        Gtk.Label {
          label: _("Replace");
        }

        Gtk.Image {
          icon-name: "chevron-down-symbolic";
        }
      }
    }
  }

  // Slides down between the header and the results — same Gtk.Revealer
  // technique FindBar's own real search bar uses for its slide-up
  // (see its own index.blp comment for why a plain Revealer, not
  // Gtk.SearchBar: that widget bakes in its own libadwaita "searchbar"
  // background/shadow, which is exactly wrong here — this row's whole
  // point is to look like part of the results view itself, not a
  // distinct bar floating over it.
  Gtk.Revealer replace_revealer {
    transition-type: slide_down;
    reveal-child: false;

    Gtk.Box replace_row {
      styles ["find-results-replace-row"]
      orientation: vertical;
      spacing: 8;

      // The searched term, read-only — not a Gtk.Entry: it needs more
      // than one trailing icon (one per active toggle), which Entry's
      // own single secondary-icon slot can't do. find_icons is
      // populated in code (tab-find-results/index.vala's own
      // on_replace_button_toggled()), one per toggle the search
      // actually used. outline-input-disabled (on top of the plain
      // outline-input both sides share — see common.css) is what gives
      // this side its own muted background — sensitive: false alone
      // would otherwise still read as a plain, active-looking field.
      Gtk.Box {
        styles ["outline-input", "outline-input-disabled"]

        Gtk.Text find_text {
          hexpand: true;
          editable: false;
          sensitive: false;
        }

        Gtk.Box find_icons {
          spacing: 4;
          halign: end;
        }
      }

      Gtk.Box {
        orientation: horizontal;
        spacing: 8;

        Gtk.Text replace_text {
          styles ["outline-input"]
          hexpand: true;
          placeholder-text: _("Type the replacement text…");
        }

        // The actual Replace action — see confirm_and_replace_all() for
        // the confirmation dialog it opens. Same icon/tooltip as
        // FindBar's own replace_all_button (data/icons/ has no dedicated
        // "replace"/"replace all" icon in Material Symbols, see that
        // button's own comment) — reusing it here instead of a second
        // one under a different name.
        Gtk.Button replace_confirm_button {
          styles ["compact-control", "suggested-action"]
          icon-name: "replace-all-symbolic";
          tooltip-text: _("Replace All");
        }
      }
    }
  }

  Gtk.Separator {
    styles ["content-divider"]
  }
}
