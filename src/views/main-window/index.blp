using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  // default-width/default-height are set from GLib.Settings instead
  // (MainWindowView's own constructor) — the last closed window's own
  // size, not a fixed one.
  // The window itself carries the "view" background, matching the main
  // content column's own opus-main color underneath everything else.
  styles ["view"]

  // Single header spanning the full window width, above both the sidebar
  // and the main content — unlike the old per-pane headers (one on the
  // sidebar, one on the content), there's now only one, so it's a sibling
  // of split_view rather than nested inside either of its panes. That also
  // means Adw.HeaderBar's own "Split View Integration" (relocating the
  // window's close/minimize/maximize controls once a nested sidebar
  // collapses) doesn't come into play here: with one header always on
  // top regardless of collapse state, the controls just always live here,
  // no special-casing needed.
  content: Adw.ToolbarView {
    // raised (not flat): "Opaque background with a persistent shadow"
    // (libadwaita's own doc comment, adw-toolbar-view.c) — matches GNOME
    // Text Editor's own header, checked against ~/Downloads/gnome-text-editor.
    // bottom-bar-style matches, for the search bar below — see
    // search_bar_bin's own comment.
    top-bar-style: raised;
    bottom-bar-style: raised;

    [top]
    Adw.HeaderBar {
      styles ["opus-header"]

      title-widget: Adw.ViewSwitcher {
        stack: view_stack;
        policy: wide;
      };

      // Only shown once the sidebar has actually collapsed AND a folder
      // is linked (see MainWindowView's own
      // update_sidebar_toggle_visibility) — with the sidebar sitting
      // permanently side-by-side, or none linked at all, there's nothing
      // useful for it to reveal. Adw.OverlaySplitView already dismisses
      // the revealed sidebar on an outside click on its own (its own
      // "shield" widget — checked its source, not assumed); this button
      // only needs to handle showing it.
      [start]
      Gtk.ToggleButton sidebar_toggle_button {
        icon-name: "sidebar-show-symbolic";
        tooltip-text: _("Toggle Sidebar");
        visible: false;
      }

      [end]
      Gtk.MenuButton menu_button {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
      }
    }

    content: Adw.OverlaySplitView split_view {
      // Off by default, on only once collapsed (see the breakpoint below)
      // — matches Nautilus's own split_view exactly (checked its source):
      // a swipe shouldn't reveal/hide the sidebar while there's still
      // room for it to sit permanently side-by-side.
      enable-show-gesture: false;
      enable-hide-gesture: false;

      sidebar: Gtk.Box {
        orientation: horizontal;
        styles ["opus-sidebar"]

        Adw.Bin sidebar_bin {
          hexpand: true;
        }

        // Drag-to-resize handle — split_view itself has no such thing
        // built in (AdwOverlaySplitView only exposes a *fraction* of the
        // total width plus static min/max bounds, no interactive resize;
        // checked its real source, no drag gesture/cursor logic anywhere
        // in it). Sits right where the sidebar visually ends, so it reads
        // as the boundary between the two panes even though it's actually
        // just the sidebar's own trailing child — see
        // MainWindowView.setup_sidebar_resize() for the actual drag logic.
        Gtk.Box sidebar_resize_handle {
          styles ["sidebar-resize-handle"]
          width-request: 4;
        }
      };

      content: Gtk.Box {
        orientation: vertical;
        styles ["opus-main"]

        Adw.ViewStack view_stack {
          vexpand: true;

          Adw.ViewStackPage {
            name: "editor";
            title: _("Editor");
            icon-name: "code-symbolic";

            // Not an Adw.ToolbarView: ANY top/bottom bar of one doubles as
            // a Gtk.WindowHandle (drag-to-move-the-window), which raced
            // against — and often won over — the tab bar's own (now
            // removed) hand-rolled drag-to-reorder gesture; kept as a plain
            // Box since real Gtk.DragSource/DropTarget (see TabBarView's
            // own setup_reorder_drag_drop()) has no such conflict, but
            // there's no reason to reintroduce a WindowHandle here now.
            child: Gtk.Box {
              orientation: vertical;

              // Hidden entirely with no tabs open (see
              // MainWindowView.show_empty_state()/show_content()) — an
              // empty tab bar sitting over the empty-state placeholder has
              // nothing to switch between.
              Gtk.Box tab_bar_row {
                orientation: vertical;

                Adw.Bin tab_bar_bin {}
                Gtk.Separator {
                  styles ["content-divider"]
                }
              }

              // Holds whatever the active tab shows — today always
              // EditorView's widget, but not assumed to be: see
              // show_editor()/show_empty_state() in index.vala. Starts
              // (and returns to, once the last tab closes) an empty-state
              // placeholder rather than an editor with nothing open in it.
              Adw.Bin content_bin {
                vexpand: true;
              }
            };
          }

          Adw.ViewStackPage {
            name: "git";
            title: _("Git");
            icon-name: "git-symbolic";

            child: Adw.StatusPage {
              title: _("Git integration coming soon");
            };
          }
        }
      };
    };

    // Filled in code (MainWindowView's own constructor) with SearchBar's
    // widget — see src/views/CLAUDE.md for why a custom type never
    // appears here by name directly. Sibling of split_view, not nested
    // inside its content column: spans the *whole* window width, below
    // the sidebar too, the same way the header above it does — a
    // per-editor-column bar would've been squeezed to the right of the
    // sidebar instead. libadwaita's own real toolbarview stylesheet
    // (_toolbars.scss) already flattens a `searchbar` node nested inside
    // a toolbarview's own bar slot (`%searchbar-inline` — no background/
    // shadow of its own) exactly so it reads as part of *this* bar
    // instead of stacking two bars visually; bottom-bar-style: raised
    // above is what actually paints that shared background now.
    [bottom]
    Adw.Bin search_bar_bin {}
  };

  // Collapses the sidebar into an overlay once the window gets narrow —
  // same threshold Nautilus's own equivalent breakpoint uses.
  Adw.Breakpoint {
    condition ("max-width: 682sp")

    setters {
      split_view.collapsed: true;
      split_view.enable-show-gesture: true;
      split_view.enable-hide-gesture: true;
    }
  }
}
