using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  default-width: 900;
  default-height: 600;
  // Matches Nautilus: the window itself carries the "view" background;
  // a flat (non-raised) Adw.ToolbarView top bar paints no background of
  // its own, so the window's shows through underneath it uninterrupted.
  styles ["view"]

  // Spans the whole window so a floating widget (e.g. a dragged tab's
  // ghost, see show_floating() below) can be positioned anywhere on
  // screen, not just within whichever narrower widget started the drag.
  content: Gtk.Overlay floating_layer {
    child: Adw.OverlaySplitView split_view {
      sidebar: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-end-title-buttons: false;
          decoration-layout: "close:";
          title-widget: Adw.WindowTitle window_title {};
        }

        content: Adw.Bin sidebar_bin {};
      };

      content: Adw.ToolbarView {
        top-bar-style: flat;

        [top]
        Adw.HeaderBar {
          show-start-title-buttons: false;
          show-end-title-buttons: false;

          title-widget: Adw.ViewSwitcher {
            stack: view_stack;
            policy: wide;
          };
        }

        content: Adw.ViewStack view_stack {
          Adw.ViewStackPage {
            name: "editor";
            title: _("Editor");
            icon-name: "code-symbolic";

            // Not an Adw.ToolbarView: ANY top/bottom bar of one doubles as
            // a Gtk.WindowHandle (drag-to-move-the-window), which races
            // against — and often wins over — the tab bar's own
            // drag-to-reorder gesture. A plain Box has no such behavior.
            // It also paints no background of its own, so the window's
            // own "view" background (see the `styles ["view"]` above)
            // shows through here the same as it does behind content_bin,
            // instead of "raised"'s opaque header-bar-colored one.
            child: Gtk.Box {
              orientation: vertical;

              Adw.Bin tab_bar_bin {}
              Gtk.Separator {
                styles ["content-divider"]
              }

              // Holds whatever the active tab shows — today always
              // EditorView's widget, but not assumed to be: see
              // show_editor()/show_empty_state() in index.vala. Starts (and
              // returns to, once the last tab closes) an empty-state
              // placeholder rather than an editor with nothing open in it.
              Adw.Bin content_bin {
                vexpand: true;
              }
            };
          }

          Adw.ViewStackPage {
            name: "git";
            title: _("Git");
            icon-name: "git-symbolic";

            child: Adw.StatusPage {
              title: _("Git integration coming soon");
            };
          }
        };
      };
    };
  };
}
