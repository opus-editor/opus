using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  // default-width/default-height are set from GLib.Settings instead
  // (MainWindow's own constructor) — the last closed window's own
  // size, not a fixed one.
  // The window itself carries the "view" background, matching the main
  // content column's own opus-main color underneath everything else.
  styles ["view"]

  // A single header spans the full window width, above both the sidebar
  // and the main content, as a sibling of split_view rather than nested
  // inside either of its panes. That also means Adw.HeaderBar's own
  // "Split View Integration" (relocating the window's close/minimize/
  // maximize controls once a nested sidebar collapses) doesn't come into
  // play here: with one header always on top regardless of collapse
  // state, the controls just always live here, no special-casing needed.
  content: Adw.ToolbarView {
    // raised (not flat): "Opaque background with a persistent shadow"
    // (libadwaita's own doc comment, adw-toolbar-view.c) — matches GNOME
    // Text Editor's own header, checked against ~/Downloads/gnome-text-editor.
    // bottom-bar-style matches, for the search bar below — see
    // search_bar_bin's own comment.
    top-bar-style: raised;
    bottom-bar-style: raised;

    [top]
    Adw.HeaderBar {
      styles ["opus-header"]

      // A stack, so Ctrl+P can swap the switcher for the Command Bar's
      // entry at the exact same spot (see MainWindow.open_command_bar):
      // the switcher hides, the entry takes its allocation — VS Code's
      // own Command Center does the same hide/show trick, not a morph.
      title-widget: Gtk.Stack title_stack {
        hhomogeneous: true;
        transition-type: crossfade;
        transition-duration: 120;

        Gtk.StackPage {
          name: "switcher";
          // halign: center — the stack is hhomogeneous, so it reserves
          // the Command Bar page's own (clamped, hexpand) width for both
          // pages; without this the switcher fills that whole box
          // instead of keeping its natural compact size in the middle.
          // The clamp only bites below the narrow breakpoint: each wide
          // button asks for 120px of natural width by code
          // (adw-view-switcher-button.c, MIN_NAT_BUTTON_WIDTH_WIDE), which
          // no padding brings down, so with the titles gone the icons are
          // boxed in from outside instead.
          child: Adw.Clamp switcher_clamp {
            // Inert while wide: below its threshold a clamp hands the
            // child the whole width.
            maximum-size: 10000;
            tightening-threshold: 10000;

            child: Adw.ViewSwitcher view_switcher {
              stack: view_stack;
              policy: wide;
              halign: center;
            };
          };
        }

        Gtk.StackPage {
          name: "command-bar";
          // Filled in code with CommandBarPopover's own entry widget —
          // see src/views/AGENTS.md for why a custom type never
          // appears here by name directly.
          child: Adw.Bin command_bar_bin {};
        }
      };

      // Only shown while a folder is linked and its sidebar is out of
      // sight — hidden by Ctrl+B, or collapsed by the breakpoint below
      // (see MainWindow's own update_folder_dependent_ui): with the
      // sidebar sitting side-by-side, or no folder at all, there's
      // nothing for it to reveal. Adw.OverlaySplitView already dismisses
      // the revealed sidebar on an outside click on its own (its own
      // "shield" widget — checked its source, not assumed); this button
      // only needs to handle showing it.
      [start]
      Gtk.ToggleButton sidebar_toggle_button {
        icon-name: "sidebar-show-symbolic";
        tooltip-text: _("Toggle Sidebar");
        visible: false;
      }

      [end]
      Gtk.MenuButton menu_button {
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
      }

      // Declared after menu_button — Adw.HeaderBar packs each further
      // [end] child inward from the previous one, so this lands to
      // menu_button's own left. Bound to properties_split_view's own
      // show-sidebar in code, like GNOME Text Editor's properties_button.
      [end]
      Gtk.ToggleButton properties_button {
        icon-name: "dialog-information-symbolic";
        tooltip-text: _("Document Properties");
      }
    }

    // Error toasts (MainWindow.show_failure_toast) float over the whole
    // content area, sidebar included, above the search bar below.
    content: Adw.ToastOverlay toast_overlay {
      // The Document Properties pane, around everything else — sidebar
      // and content included — the way GNOME Text Editor's own
      // multi_layout wraps its window (editor-window.ui): a split view
      // to the right while there is room, a bottom sheet once the
      // breakpoint below switches the layout. The two slots carry the
      // same two widgets into whichever layout is active.
      child: Adw.MultiLayoutView properties_layout {
        Adw.Layout {
          name: "wide";

          // Hidden until properties_button shows it; 350 is GNOME Text
          // Editor's own min-sidebar-width for it.
          content: Adw.OverlaySplitView properties_split_view {
            sidebar-position: end;
            show-sidebar: false;
            enable-show-gesture: false;
            enable-hide-gesture: false;
            min-sidebar-width: 350;
            max-sidebar-width: 350;

            sidebar: Adw.LayoutSlot {
              id: "properties";
            };

            content: Adw.LayoutSlot {
              id: "content";
            };
          };
        }

        Adw.Layout {
          name: "narrow";

          content: Adw.BottomSheet properties_sheet {
            content: Adw.LayoutSlot {
              id: "content";
            };

            // A toolbar view, as GNOME Text Editor wraps its own: the
            // sheet's background and the pane's rows then share a surface.
            sheet: Adw.ToolbarView {
              content: Adw.LayoutSlot {
                id: "properties";
              };
            };
          };
        }

        // Filled in code with DocumentPanel's widget.
        [properties]
        Adw.Bin properties_bin {}

        [content]
        Adw.OverlaySplitView split_view {
          // Off by default, on only once collapsed (see the breakpoint below)
          // — matches Nautilus's own split_view exactly (checked its source):
          // a swipe shouldn't reveal/hide the sidebar while there's still
          // room for it to sit permanently side-by-side.
          enable-show-gesture: false;
          enable-hide-gesture: false;

          sidebar: Gtk.Overlay {
            styles ["opus-sidebar"]

            child: Adw.Bin sidebar_bin {};

            // Drag-to-resize handle — split_view itself has no such thing
            // built in (AdwOverlaySplitView only exposes a *fraction* of the
            // total width plus static min/max bounds, no interactive resize;
            // checked its real source, no drag gesture/cursor logic anywhere
            // in it). An overlay, not a plain trailing sibling in a Gtk.Box:
            // a sibling reserves its own width-request off to the side,
            // which left sidebar_bin's own content — ExplorerPaneTree's
            // rows included — permanently 4px short of the sidebar's real
            // right edge. Floating on top instead (halign: end) means
            // sidebar_bin fills the whole sidebar, and the handle merely
            // sits over its rightmost 4px — still fully interactive
            // (can-target defaults to true, unlike TabBar's own inert fade
            // overlays), so MainWindow.setup_sidebar_resize()'s drag/click
            // gestures need no change at all.
            [overlay]
            Gtk.Box sidebar_resize_handle {
              styles ["sidebar-resize-handle"]
              width-request: 4;
              halign: end;
              valign: fill;
            }
          };

          content: Gtk.Box {
            orientation: vertical;
            styles ["opus-main"]

            Adw.ViewStack view_stack {
              vexpand: true;

              Adw.ViewStackPage editor_page {
                name: "editor";
                title: _("Editor");
                icon-name: "opus-code-symbolic";

                // Holds whatever the active tab shows — today always
                // EditorView.EditorPaneWidget's own widget (tab bar + editor,
                // assembled by EditorPaneWidget itself), but not assumed to be: see
                // show_content()/show_empty_state() in index.vala. Starts
                // (and returns to, once the last tab closes) an empty-state
                // placeholder rather than an editor with nothing open in it.
                child: Adw.Bin content_bin {
                  vexpand: true;
                };
              }

              Adw.ViewStackPage git_page {
                name: "git";
                title: _("Git");
                icon-name: "opus-git-symbolic";

                // Filled in code with GitView.TreePane's widget — see
                // src/views/AGENTS.md for why a custom type never appears
                // here by name directly.
                child: Adw.Bin tree_bin {};
              }
            }
          };
        }
      };
    };

    // Filled in code (MainWindow's own constructor) with EditorView.FindBar's
    // widget — see src/views/AGENTS.md for why a custom type never
    // appears here by name directly. Sibling of split_view, not nested
    // inside its content column: spans the *whole* window width, below
    // the sidebar too, the same way the header above it does — a
    // per-editor-column bar would've been squeezed to the right of the
    // sidebar instead. libadwaita's own real toolbarview stylesheet
    // (_toolbars.scss) already flattens a `searchbar` node nested inside
    // a toolbarview's own bar slot (`%searchbar-inline` — no background/
    // shadow of its own) exactly so it reads as part of *this* bar
    // instead of stacking two bars visually; bottom-bar-style: raised
    // above is what actually paints that shared background now.
    [bottom]
    Adw.Bin search_bar_bin {
      // Shown only while a panel is open — see MainWindow.set_active_bottom_panel.
      visible: false;
    }
  };

  // Collapses the sidebar into an overlay once the window gets narrow —
  // same threshold Nautilus's own equivalent breakpoint uses.
  Adw.Breakpoint {
    condition ("max-width: 682sp")

    setters {
      split_view.collapsed: true;
      split_view.enable-show-gesture: true;
      split_view.enable-hide-gesture: true;
      properties_layout.layout-name: "narrow";
    }
  }

  // Narrower still, the header's switcher keeps its icons alone: the
  // titles go, the clamp boxes the buttons in, and MainWindow trims
  // their padding on apply (icons-only). Only the last matching
  // breakpoint applies (adw-breakpoint-bin.c), so the one above is
  // repeated here rather than added to.
  Adw.Breakpoint switcher_breakpoint {
    condition ("max-width: 480sp")

    setters {
      split_view.collapsed: true;
      split_view.enable-show-gesture: true;
      split_view.enable-hide-gesture: true;
      properties_layout.layout-name: "narrow";
      editor_page.title: "";
      git_page.title: "";
      switcher_clamp.maximum-size: 96;
      switcher_clamp.tightening-threshold: 0;
    }
  }
}
