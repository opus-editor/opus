using Gtk 4.0;

// GtkScrolledWindow is a final type in GTK4 (it can't be subclassed), so
// EditorView doesn't use this as a composite template — it loads this as a
// plain widget tree via Gtk.Builder and owns the root, per the View-as-facade
// pattern (see CLAUDE.md). The text view itself (an OpusSourceView, see
// _source-view.vala) isn't declared here at all — it's a custom subclass
// built and attached to scrolled_window in code, not by name in Blueprint;
// nothing else in this codebase references a custom app-defined type from
// a .blp file, so this avoids being the first to rely on that working.
Gtk.Box root {
  orientation: vertical;

  // Matches GNOME Text Editor's own "File Has Changed on Disk" banner
  // (EditorInfoBar, built on GtkInfoBar — deprecated in GTK4 with no
  // direct replacement, so not used here directly): the size/color below
  // is copied straight out of GTK's own real "infobar > revealer > box" /
  // "infobar.warning" rules (extracted from libgtk-4.so's compiled CSS,
  // not guessed), so it comes from the same system tokens GtkInfoBar
  // itself uses and still tracks light/dark and the accent color
  // automatically. Deliberately without its own close button — see
  // change_banner_discard_button's own comment below for why.
  Gtk.Revealer change_banner_revealer {
    transition-type: slide_down;

    Gtk.Box {
      styles ["change-banner"]
      orientation: horizontal;
      spacing: 6;

      Gtk.Box {
        orientation: vertical;
        spacing: 6;
        hexpand: true;
        valign: center;

        Gtk.Label {
          styles ["change-banner-title"]
          halign: start;
          wrap: true;
          label: _("File Has Changed on Disk");
        }

        Gtk.Label {
          halign: start;
          wrap: true;
          label: _("The file has been changed by another program.");
        }
      }

      // No close button: dismissing it without resolving anything was
      // exactly what "unsynchronized" — the underlying state the banner
      // itself is showing (see EditorController.mark_externally_modified)
      // — needs to *not* let happen; the tab itself already carries its
      // own persistent reminder (the modified dot, and its tooltip) once
      // this closes, so there's nothing extra lost by not offering one.
      Gtk.Button change_banner_discard_button {
        valign: center;
        label: _("_Discard Changes and Reload");
        use-underline: true;
      }
    }
  }

  Gtk.ScrolledWindow scrolled_window {
    vexpand: true;
    hscrollbar-policy: automatic;
    vscrollbar-policy: automatic;
  }
}
