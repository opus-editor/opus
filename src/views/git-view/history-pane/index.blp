using Gtk 4.0;
using Adw 1;

// Same header shape as StagingPane's own (git-view/staging-pane/index.blp),
// reusing its file-tree-root-label/file-tree-branch-label classes — the
// "..." slot holds a close button here instead.
Gtk.Box root_box {
  orientation: vertical;

  Gtk.Box root_header_box {
    Gtk.Box {
      styles ["mt-200", "me-150", "ms-300", "mb-200"]
      orientation: vertical;
      hexpand: true;

      Gtk.Label commit_label {
        styles ["file-tree-root-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }

      Gtk.Label author_label {
        styles ["file-tree-branch-label", "dim-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }
    }

    Gtk.Box {
      styles ["mt-200", "me-150", "mb-200"]
      orientation: vertical;
      margin-start: 0;

      Gtk.Button close_button {
        styles ["btn-sm", "btn-icon", "flat"]
        icon-name: "close-symbolic";
        tooltip-text: _("Back to WIP");
      }
    }
  }

  // The commit's message, read-only — not styled as an input like the
  // box StagingPane types into: a plain block of text edge to edge,
  // using the whole sidebar width (see staging-pane.css's own
  // .history-message-view), with a hairline above and below.
  Gtk.ScrolledWindow {
    height-request: 160;
    hscrollbar-policy: never;

    Gtk.TextView message_view {
      styles ["history-message-view"]
      editable: false;
      cursor-visible: false;
      wrap-mode: word_char;
      top-margin: 10;
      bottom-margin: 10;
      left-margin: 12;
      right-margin: 12;
    }
  }

  Gtk.Box {
    styles ["mt-400", "mb-200"]
    orientation: horizontal;

    Gtk.Label {
      styles ["heading", "mt-150", "mb-150", "ms-300", "me-150"]
      label: _("Files");
      halign: start;
      hexpand: true;
    }
  }

  Gtk.ScrolledWindow files_scrolled {
    styles ["undershoot-top", "undershoot-bottom"]
    vexpand: true;
  }
}
