using Gtk 4.0;

// Same header shape as StagingPane's own (git-view/staging-pane/index.blp),
// reusing its file-tree-root-label/file-tree-branch-label classes — the
// "..." slot holds a close button here instead.
Gtk.Box root_box {
  orientation: vertical;

  Gtk.Box root_header_box {
    styles ["sidebar-pane-header"]

    Gtk.Box {
      styles ["me-150", "ms-300"]
      orientation: vertical;
      // A hair between the two lines, and the 30px that lands the pair
      // dead center in the header's own 30 — see .sidebar-pane-header.
      spacing: 1;
      valign: center;
      hexpand: true;

      Gtk.Label commit_label {
        styles ["file-tree-root-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }

      Gtk.Label author_label {
        styles ["file-tree-branch-label", "dim-label"]
        label: "";
        halign: start;
        ellipsize: end;
      }
    }

    Gtk.Box {
      styles ["me-150"]
      orientation: vertical;
      valign: center;
      margin-start: 0;

      Gtk.Button close_button {
        styles ["btn-sm", "btn-icon", "flat"]
        icon-name: "opus-close-symbolic";
        tooltip-text: _("Back to WIP");
      }
    }
  }

  // The commit's subject as a heading, the same shape as "Files" below,
  // and a "Read more" link under it while the message has a body.
  Gtk.Box {
    orientation: vertical;

    Gtk.Label subject_label {
      styles ["heading", "commit-subject", "mt-150", "ms-300", "me-150"]
      label: "";
      halign: start;
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;
    }

    Gtk.Label read_more_label {
      styles ["ms-300", "me-150", "mt-100"]
      label: _("<a href=\"more\">Read more</a>");
      use-markup: true;
      halign: start;
      visible: false;
    }
  }

  Gtk.Box {
    styles ["mt-200", "mb-200"]
    orientation: horizontal;

    Gtk.Label {
      styles ["heading", "mt-150", "mb-150", "ms-300", "me-150"]
      label: _("Files");
      halign: start;
      hexpand: true;
    }
  }

  Gtk.ScrolledWindow files_scrolled {
    styles ["undershoot-top", "undershoot-bottom"]
    vexpand: true;
  }
}
