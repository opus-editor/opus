{
  "palette": {
    "gray": "#6a737d",
    "blue": "#005cc5",
    "blue-dark": "#024694",
    "purple": "#6f42c1",
    "violet": "#a33e85",
    "red": "#d73a49",
    "red-dark": "#b31d28",
    "green": "#22863a",
    "orange": "#e36209",
    "red-wash": "#ffeef0",
    "green-wash": "#f0fff4",
    "orange-wash": "#ffebda"
  },
  "syntax": {
    "attribute": { "foreground": "purple" },
    "comment": { "foreground": "gray" },
    "constant": { "foreground": "blue" },
    "constant.builtin": { "foreground": "orange" },
    "constant.numeric": { "foreground": "orange" },
    "constructor": { "foreground": "purple" },
    "diff.delta": { "foreground": "orange", "background": "orange-wash" },
    "diff.minus": { "foreground": "red-dark", "background": "red-wash" },
    "diff.plus": { "foreground": "green", "background": "green-wash" },
    "function": { "foreground": "purple" },
    "function.builtin": { "foreground": "blue" },
    "function.macro": { "foreground": "purple" },
    "keyword": { "foreground": "red" },
    "keyword.operator": { "foreground": "red" },
    "keyword.storage": { "foreground": "red" },
    "keyword.storage.modifier": { "foreground": "red" },
    "keyword.storage.type": { "foreground": "red" },
    "label": { "foreground": "purple" },
    "markup.bold": { "bold": true },
    "markup.heading": { "foreground": "purple", "bold": true },
    "markup.italic": { "italic": true },
    "markup.link.label": { "foreground": "blue-dark", "underline": true },
    "markup.link.text": { "foreground": "blue-dark", "underline": true },
    "markup.link.url": { "foreground": "blue-dark", "underline": true },
    "markup.quote": { "foreground": "green" },
    "markup.raw": { "foreground": "blue-dark" },
    "markup.strikethrough": { "strikethrough": true },
    "namespace": { "foreground": "purple" },
    "operator": { "foreground": "red" },
    "string": { "foreground": "blue" },
    "string.regexp": { "foreground": "blue" },
    "string.special.url": { "foreground": "blue", "underline": true },
    "tag": { "foreground": "violet" },
    "type": { "foreground": "purple" },
    "type.builtin": { "foreground": "red" },
    "type.enum.variant": { "foreground": "red" },
    "variable.builtin": { "foreground": "red" },
    "variable.other.member": { "foreground": "editor.foreground" }
  },
  "languages": {
    "markdown": {
      "label": { "foreground": "blue-dark" }
    },
    "json": {
      "variable.other.member": { "foreground": "purple" }
    },
    "toml": {
      "punctuation.bracket": { "foreground": "purple" }
    },
    "ruby": {
      "string.special.symbol": { "foreground": "orange" }
    },
    "bash": {
      "string": { "foreground": "editor.foreground" }
    }
  }
}
